diff --git a/sound/soc/codecs/mt6357.c b/sound/soc/codecs/mt6357.c
index 674cf7df9..864bb8f6c 100644
--- a/sound/soc/codecs/mt6357.c
+++ b/sound/soc/codecs/mt6357.c
@@ -6,6 +6,7 @@
  * Author: Nicolas Belin <nbelin@baylibre.com>
  */
 
+#include <linux/delay.h>
 #include <linux/dma-mapping.h>
 #include <sound/soc.h>
 #include <sound/tlv.h>
@@ -1017,6 +1018,14 @@ static int lo_mux_event(struct snd_soc_dapm_widget *w,
 	lgain = lgain & MT6357_AUD_LOL_GAIN_MASK;
 	switch (event) {
 	case SND_SOC_DAPM_POST_PMU:
+		/*
+		 * The DL supply widgets may already have been powered when the
+		 * lineout mux turns on, so mt_audio_in_event() does not run
+		 * again and the NCP/LDO/NV regulators stay off.  The vendor's
+		 * Speaker_Amp_Change() powers the whole analog chain from this
+		 * path; do the same here.
+		 */
+		configure_downlinks(priv, true);
 		/* Set -40dB before enable HS to avoid POP noise */
 		regmap_update_bits(priv->regmap, MT6357_ZCD_CON1,
 				   MT6357_AUD_LOL_GAIN_MASK |
@@ -1034,6 +1043,14 @@ static int lo_mux_event(struct snd_soc_dapm_widget *w,
 		regmap_update_bits(priv->regmap, MT6357_AUDDEC_ANA_CON4,
 				   MT6357_AUD_LOL_PWRUP_VAUDP15_MASK,
 				   MT6357_AUD_LOL_PWRUP_VAUDP15_ENABLE);
+		/*
+		 * Vendor Speaker_Amp_Change() ends with CON6 = 0x0201:
+		 * main CMFB loop on, bit7 cleared.
+		 */
+		regmap_update_bits(priv->regmap, MT6357_AUDDEC_ANA_CON6,
+				   MT6357_HPRL_MAIN_CMFB_LOOP_MASK |
+				   MT6357_HP_CMFB_RST_MASK,
+				   MT6357_HPRL_MAIN_CMFB_LOOP_ENABLE);
 		/* Set LOL gain to normal gain step by step */
 		lo_volume_ramp(priv, DL_GAIN_N_40DB, lgain,
 			       DL_GAIN_N_40DB, rgain);
@@ -1055,6 +1072,10 @@ static int lo_mux_event(struct snd_soc_dapm_widget *w,
 		regmap_update_bits(priv->regmap, MT6357_AUDDEC_ANA_CON4,
 				   MT6357_AUD_LOLOUT_STB_ENH_VAUDP15_MASK,
 				   MT6357_AUD_LOLOUT_STB_ENH_VAUDP15_DISABLE);
+		/* Disable the main CMFB loop */
+		regmap_update_bits(priv->regmap, MT6357_AUDDEC_ANA_CON6,
+				   MT6357_HPRL_MAIN_CMFB_LOOP_MASK,
+				   MT6357_HPRL_MAIN_CMFB_LOOP_DISABLE);
 		/* Save the gain value into the register*/
 		regmap_update_bits(priv->regmap, MT6357_ZCD_CON1,
 				   MT6357_AUD_LOL_GAIN_MASK |
@@ -1808,6 +1829,12 @@ static int mt6357_platform_driver_probe(struct platform_device *pdev)
 	if (ret)
 		return dev_err_probe(&pdev->dev, ret, "Failed to enable vaud28 regulator\n");
 
+	/*
+	 * Let the analog supply settle before the codec component can bind.
+	 * The board DT specifies a 264 us VAUD28 enable ramp.
+	 */
+	usleep_range(500, 1000);
+
 	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
 	if (!priv)
 		return -ENOMEM;
