 	/* If the list was never initialized there are no sub-DAIs */
 	if (afe->sub_dais.next && afe->sub_dais.prev) {
+		dev_dbg(afe->dev, "DANDELION afe comp: adding sub dai ctl\n");
 		ret = mtk_afe_add_sub_dai_control(component);
+		dev_dbg(afe->dev, "DANDELION afe comp: sub dai ctl ret=%d\n", ret);
 		if (ret)
 			return ret;
 	}
 
+	dev_dbg(afe->dev, "DANDELION afe comp: done\n");
 	return 0;
 }
 
