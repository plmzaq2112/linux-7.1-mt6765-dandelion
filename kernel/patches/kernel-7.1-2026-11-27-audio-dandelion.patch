+
+static int mt6765_mt6357_gpio_probe(struct snd_soc_card *card)
+{
+	struct mt6765_mt6357_priv *priv = snd_soc_card_get_drvdata(card);
+	int ret, i;
+
+	ret = devm_gpio_request_one(card->dev, DANDELION_SPK_AMP_GPIO,
+				    GPIOF_OUT_INIT_LOW, "spk-amp-en");
+	if (ret)
+		dev_warn(card->dev, "speaker amp GPIO %d unavailable: %d\n",
+			 DANDELION_SPK_AMP_GPIO, ret);
+	else
+		spk_amp_gpio = DANDELION_SPK_AMP_GPIO;
+
+	priv->pinctrl = devm_pinctrl_get(card->dev);
+	if (IS_ERR(priv->pinctrl)) {
+		ret = PTR_ERR(priv->pinctrl);
+		if (ret == -EPROBE_DEFER)
+			return ret;
+		dev_info(card->dev, "No pinctrl, skipping pin states\n");
+		priv->pinctrl = NULL;
+		for (i = PIN_STATE_DEFAULT ; i < PIN_STATE_MAX ; i++)
+			priv->pin_states[i] = ERR_PTR(-ENODEV);
+		goto pinctrl_done;
+	}
+
+	for (i = PIN_STATE_DEFAULT ; i < PIN_STATE_MAX ; i++) {
+		priv->pin_states[i] = pinctrl_lookup_state(priv->pinctrl,
+							   mt6765_mt6357_pin_str[i]);
+		if (IS_ERR(priv->pin_states[i])) {
+			dev_info(card->dev, "No pin state for %s\n",
+				 mt6765_mt6357_pin_str[i]);
+		} else {
+			ret = pinctrl_select_state(priv->pinctrl,
+						   priv->pin_states[i]);
+			if (ret) {
+				dev_err_probe(card->dev, ret,
+					      "Failed to select pin state %s\n",
+					      mt6765_mt6357_pin_str[i]);
+				return ret;
+			}
+		}
+	}
+
+pinctrl_done:
+	return 0;
+}
+
+static struct snd_soc_card mt6765_mt6357_soc_card = {
+	.name = "mt6765-evk",
+	.owner = THIS_MODULE,
+	.dai_link = mt6765_mt6357_dais,
+	.num_links = ARRAY_SIZE(mt6765_mt6357_dais),
+	.dapm_widgets = mt6765_mt6357_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(mt6765_mt6357_widgets),
+	.dapm_routes = mt6765_mt6357_routes,
+	.num_dapm_routes = ARRAY_SIZE(mt6765_mt6357_routes),
+};
+
+static int mt6765_mt6357_dev_probe(struct mtk_soc_card_data *soc_card_data, bool legacy)
+{
+	struct mtk_platform_card_data *card_data = soc_card_data->card_data;
+	struct snd_soc_card *card = card_data->card;
+	struct device *dev = card->dev;
+	struct mt6765_mt6357_priv *mach_priv;
+	int ret;
+
+	card->dev = dev;
+	ret = parse_dai_link_info(card);
+	if (ret)
+		goto err;
+
+	mach_priv = devm_kzalloc(dev, sizeof(*mach_priv),
+				 GFP_KERNEL);
+	if (!mach_priv)
+		return -ENOMEM;
+	soc_card_data->mach_priv = mach_priv;
+	snd_soc_card_set_drvdata(card, soc_card_data);
+	mt6765_mt6357_gpio_probe(card);
+	return 0;
+
+err:
+	clean_card_reference(card);
+	return ret;
+}
+
+static const struct mtk_soundcard_pdata mt6765_mt6357_card = {
+	.card_name = "mt6765-mt6357",
+	.card_data = &(struct mtk_platform_card_data) {
+		.card = &mt6765_mt6357_soc_card,
+	},
+	.soc_probe = mt6765_mt6357_dev_probe
+};
+
+static const struct of_device_id mt6765_mt6357_dt_match[] = {
+	{ .compatible = "mediatek,mt6765-mt6357", .data = &mt6765_mt6357_card },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, mt6765_mt6357_dt_match);
+
+static struct platform_driver mt6765_mt6357_driver = {
+	.driver = {
+		   .name = "mt6765_mt6357",
+		   .of_match_table = mt6765_mt6357_dt_match,
+		   .pm = &snd_soc_pm_ops,
+	},
+	.probe = mtk_soundcard_common_probe,
+};
+
+module_platform_driver(mt6765_mt6357_driver);
+
+/* Module information */
+MODULE_DESCRIPTION("MT6765 EVK SoC machine driver");
+MODULE_AUTHOR("Nicolas Belin <nbelin@baylibre.com>");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("platform: mt6765_mt6357");
