+int mt6765_afe_set_i2s_out(struct mtk_base_afe *afe,
+			   unsigned int rate, int bit_width)
+{
+	struct mt6765_afe_private *afe_priv = afe->platform_priv;
+	struct mtk_afe_i2s_priv *i2s_data =
+		afe_priv->dai_priv[MT6765_AFE_IO_I2S];
+
+	return mt6765_dai_set_config(afe, i2s_data, false, rate, bit_width);
+}
