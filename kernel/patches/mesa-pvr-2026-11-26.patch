+   pvr_put_u64(dst + 0x18, r->tpu_border_colour_table);
+   pvr_put_u32(dst + 0x20, r->ppp_ctrl);
+   pvr_put_u32(dst + 0x24, r->te_psg);
+   pvr_put_u32(dst + 0x28, r->tpu);
+   pvr_put_u32(dst + 0x2c, r->view_idx);
