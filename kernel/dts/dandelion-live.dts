		clock-controller@10006000 {
			compatible = "mediatek,mt6765-scpsys", "syscon", "simple-mfd";
			reg = <0x00 0x10006000 0x00 0x1000>;
			phandle = <0x71>;

			power-controller {
				compatible = "mediatek,mt6765-power-controller";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				#power-domain-cells = <0x01>;
				phandle = <0x1d>;

				power-domain@0 {
					reg = <0x00>;
					#power-domain-cells = <0x00>;
				};

				power-domain@1 {
					reg = <0x01>;
					#power-domain-cells = <0x00>;
				};

				power-domain@2 {
					reg = <0x02>;
					#power-domain-cells = <0x00>;
				};

				power-domain@3 {
					reg = <0x03>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#power-domain-cells = <0x01>;
					clocks = <0x11 0x62 0x12 0x13 0x12 0x15 0x12 0x16 0x12 0x14>;
					clock-names = "mm", "mm-0", "mm-1", "mm-2", "mm-3";

					power-domain@5 {
						reg = <0x05>;
						#power-domain-cells = <0x00>;
						clocks = <0x13 0x00 0x12 0x18>;
						clock-names = "isp-0", "isp-1";
					};

					power-domain@9 {
						reg = <0x09>;
						#power-domain-cells = <0x00>;
						clocks = <0x14 0x00 0x14 0x01 0x14 0x02 0x14 0x08 0x12 0x19>;
						clock-names = "cam-0", "cam-1", "cam-2", "cam-3", "cam-4";
					};

					power-domain@10 {
						reg = <0x0a>;
						clocks = <0x15 0x01 0x15 0x03 0x15 0x02>;
						clock-names = "vcodec-0", "vcodec-1", "vcodec-2";
						#power-domain-cells = <0x00>;
					};
				};

				power-domain@6 {
					reg = <0x06>;
					#power-domain-cells = <0x00>;
				};

				power-domain@8 {
					reg = <0x08>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#power-domain-cells = <0x01>;
					phandle = <0x72>;

					power-domain@4 {
						reg = <0x04>;
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						#power-domain-cells = <0x01>;
						clocks = <0x11 0x64>;
						clock-names = "mfg";

						power-domain@7 {
							reg = <0x07>;
							#power-domain-cells = <0x00>;
						};
					};
				};
			};
		};

		reset-controller@10007000 {
			compatible = "mediatek,mt6765-wdt", "mediatek,mt6589-wdt";
			reg = <0x00 0x10007000 0x00 0x100>;
			interrupts = <0x00 0x8b 0x08>;
			phandle = <0x73>;
		};

		clock-controller@1000c000 {
			compatible = "mediatek,mt6765-apmixedsys", "syscon";
			reg = <0x00 0x1000c000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x28>;
		};

		pwrap@1000d000 {
			compatible = "mediatek,mt6765-pwrap";
			reg = <0x00 0x1000d000 0x00 0x1000>;
			reg-names = "pwrap";
			interrupts = <0x00 0xb3 0x04>;
			clocks = <0x11 0x00 0x16 0x00>;
			clock-names = "spi", "wrap";
			status = "okay";
