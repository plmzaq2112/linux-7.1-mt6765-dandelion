	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	fixed-factor-clock-13m {
		compatible = "fixed-factor-clock";
		#clock-cells = <0x00>;
		clocks = <0x0e>;
		clock-div = <0x02>;
		clock-mult = <0x01>;
		clock-output-names = "clk13m";
		phandle = <0x17>;
	};

	oscillator {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x18cba80>;
		clock-output-names = "clk26m";
		phandle = <0x0e>;
	};

	oscillator1 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x8000>;
		clock-output-names = "clk32k";
		phandle = <0x2e>;
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x0f>;
		interrupts = <0x01 0x0d 0x08 0x01 0x0e 0x08 0x01 0x0b 0x08 0x01 0x0a 0x08>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupt-parent = <0x0f>;
		interrupts = <0x01 0x07 0x08>;
	};

	soc {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		efuse@08000000 {
			compatible = "mediatek,efuse";
			reg = <0x00 0x8000000 0x00 0x10>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			phandle = <0x6e>;
		};

		interrupt-controller@0c000000 {
			compatible = "arm,gic-v3";
			reg = <0x00 0xc000000 0x00 0x40000 0x00 0xc100000 0x00 0x200000 0x00 0xc400000 0x00 0x2000 0x00 0xc410000 0x00 0x2000 0x00 0xc420000 0x00 0x20000>;
			#interrupt-cells = <0x03>;
			interrupt-parent = <0x0f>;
			interrupts = <0x01 0x09 0x04>;
			interrupt-controller;
			phandle = <0x0f>;
		};

		clock-controller@10000000 {
			compatible = "mediatek,mt6765-topckgen", "syscon";
			reg = <0x00 0x10000000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x11>;
		};

		clock-controller@10001000 {
			compatible = "mediatek,mt6765-infracfg", "syscon";
			reg = <0x00 0x10001000 0x00 0x1000>;
			interrupts = <0x00 0x93 0x01>;
			#clock-cells = <0x01>;
			phandle = <0x16>;
		};

		clock-controller@10003000 {
			compatible = "mediatek,mt6765-pericfg", "syscon";
			reg = <0x00 0x10003000 0x00 0x1000>;
			phandle = <0x6f>;
		};

		pin-controller@10005000 {
			compatible = "mediatek,mt6765-pinctrl";
			reg = <0x00 0x10005000 0x00 0x1000 0x00 0x10002c00 0x00 0x200 0x00 0x10002800 0x00 0x200 0x00 0x10002a00 0x00 0x200 0x00 0x10002000 0x00 0x200 0x00 0x10002200 0x00 0x200 0x00 0x10002400 0x00 0x200 0x00 0x10002600 0x00 0x200 0x00 0x1000b000 0x00 0x1000>;
			reg-names = "iocfg0", "iocfg1", "iocfg2", "iocfg3", "iocfg4", "iocfg5", "iocfg6", "iocfg7", "eint";
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x10 0x00 0x00 0xb3>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupts = <0x00 0xab 0x04>;
			phandle = <0x10>;

			spi3-pins {
				phandle = <0xc1>;

				pins {
					pinmux = <0x1501 0x1601 0x1701 0x1801>;
				};
			};

			gpio-keys-pins {
				phandle = <0x45>;

				pins {
					pinmux = <0x5d01>;
					bias-pull-up;
					input-enable;
				};
			};

			i2c5-pins {
				phandle = <0x1e>;

				pins-bus {
					pinmux = <0x3001 0x3101>;
					bias-pull-up;
				};
			};

			i2c0-pins {
				phandle = <0xbd>;

				pins-bus {
					pinmux = <0x5301 0x5201>;
					bias-pull-up;
				};
			};

			i2c1-pins {
				phandle = <0xbe>;

				pins-bus {
					pinmux = <0x5401 0x5101>;
					bias-pull-up;
				};
			};

			i2c2-pins {
				phandle = <0xbf>;

				pins-bus {
					pinmux = <0x6701 0x6801>;
					bias-pull-up;
				};
			};

			i2c3-pins {
				phandle = <0xc2>;

				pins-bus {
					pinmux = <0x3201 0x3301>;
					bias-pull-up;
				};
			};

			i2c4-pins {
				phandle = <0xc3>;

				pins-bus {
					pinmux = <0x6901 0x6a01>;
					bias-pull-up;
				};
			};

			i2c6-pins {
				phandle = <0xc4>;

				pins-bus {
					pinmux = <0xa101 0xa201>;
					bias-pull-up;
				};
			};

			mmc0-pins-default {
				phandle = <0x24>;

				pins_cmd_dat {
					pinmux = <0x7b01 0x8001 0x7d01 0x8401 0x7e01 0x8101 0x7f01 0x8202 0x7a02>;
					input-enable;
					drive-strength = <0x03>;
					bias-pull-up = <0x65>;
				};

				pins_clk {
					pinmux = <0x7c02>;
					drive-strength = <0x03>;
					bias-pull-down = <0x66>;
				};

				pins_rst {
					pinmux = <0x8502>;
					drive-strength = <0x03>;
					bias-pull-down = <0x65>;
				};
			};

			mmc0-pins-uhs {
				phandle = <0x25>;

				pins_cmd_dat {
					pinmux = <0x7b01 0x8001 0x7d01 0x8401 0x7e01 0x8101 0x7f01 0x8202 0x7a02>;
					input-enable;
					drive-strength = <0x04>;
					bias-pull-up = <0x65>;
				};

				pins_clk {
					pinmux = <0x7c02>;
					drive-strength = <0x04>;
					bias-pull-down = <0x66>;
				};

				pins_ds {
					pinmux = <0x8302>;
					drive-strength = <0x04>;
					bias-pull-down = <0x66>;
				};

				pins_rst {
					pinmux = <0x8502>;
					drive-strength = <0x03>;
					bias-pull-down = <0x65>;
				};
			};

			mmc1-default-pins {
				phandle = <0x29>;

				pins-cmd-dat {
					pinmux = <0x2001 0x2201 0x2101 0x1f01 0x1e01>;
					input-enable;
					drive-strength = <0x03>;
					bias-pull-up = <0x65>;
				};

				pins-clk {
					pinmux = <0x1d01>;
					drive-strength = <0x03>;
					bias-pull-down = <0x66>;
				};

				pins-insert {
					pinmux = <0x100>;
					bias-pull-up;
				};
			};

			uart0-pins {
				phandle = <0x70>;

				pins {
					pinmux = <0x5f01 0x6001>;
				};
			};

			usb-pins {
				phandle = <0x22>;

				id-pins {
					pinmux = <0x2901>;
					input-enable;
					bias-pull-up;
				};

				usb-vbus-pins {
					pinmux = <0x2a01>;
					output-high;
				};
			};

			lcd_bias_enp0_gpio {
				phandle = <0xc6>;

				pins_cmd_dat {
					pinmux = <0xa800>;
					slew-rate = <0x01>;
					output-low;
