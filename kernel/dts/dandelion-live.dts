		tpd-filter-custom-prameters = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
		tpd-filter-custom-speed = <0x00 0x00 0x00>;
		pinctrl-names = "default", "state_eint_as_int", "state_eint_output0", "state_eint_output1", "state_rst_output0", "state_rst_output1", "state_spi_cs_out0", "state_spi_cs_out1";
		pinctrl-0 = <0xd2>;
		pinctrl-1 = <0xd3>;
		pinctrl-2 = <0xd4>;
		pinctrl-3 = <0xd5>;
		pinctrl-4 = <0xd6>;
		pinctrl-5 = <0xd7>;
		pinctrl-6 = <0xd8>;
		pinctrl-7 = <0xd9>;
		interrupt-parent = <0x10>;
		interrupts = <0x00 0x02 0x00 0x00>;
	};

