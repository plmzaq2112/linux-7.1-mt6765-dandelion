		tpd-key-num = <0x03>;
		tpd-key-local = <0x8b 0xac 0x9e 0x00>;
		tpd-key-dim-local = <0x5a 0x373 0x64 0x28 0xe6 0x373 0x64 0x28 0x172 0x373 0x64 0x28 0x00 0x00 0x00 0x00>;
		tpd-max-touch-num = <0x0a>;
		tpd-filter-enable = <0x00>;
