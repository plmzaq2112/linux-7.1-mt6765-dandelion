/dts-v1/;

/ {
	compatible = "xiaomi,dandelion", "mediatek,mt6762", "mediatek,mt6765";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	chassis-type = "handset";
	model = "MT6762G";

	bootprof {
		lk_logo_t = <0x523>;
		lk_t = <0xdf4>;
		pl_t = <0x539>;
	};

	md_attr_node {
		mediatek,md_product_name_model_id = <0xf0f0f0f>;
		mediatek,md_drdi_rf_set_idx = <0x00>;
		compatible = "mediatek,md_attr_node";
	};

	firmware {

		android {
			mode = "normal";
			serialno = "HU8DROH6BMHIEE99";
			hardware = "mt6762";
			compatible = "android,firmware";
		};
	};

	accdet-sink {
		status = "okay";
		phandle = <0x46>;
		accdet-mic-vol = <0x06>;
		headset-mode-setting = <0x500 0x500 0x01 0x1f0 0x800 0x800 0x20 0x44>;
		accdet-plugout-debounce = <0x01>;
		accdet-mic-mode = <0x01>;
		headset-eint-level-pol = <0x08>;
		headset-three-key-threshold = <0x00 0x50 0xdc 0x190>;
		headset-three-key-threshold-CDD = <0x00 0x79 0xc0 0x258>;
		headset-four-key-threshold = <0x00 0x3a 0x79 0xc0 0x190>;
		pinctrl-names = "default", "state_eint_as_int";
		pinctrl-0 = <0xdf>;
		pinctrl-1 = <0xe0>;
	};

	audgpio-sink {
		status = "okay";
		phandle = <0x47>;
		pinctrl-names = "aud_clk_mosi_off", "aud_clk_mosi_on", "aud_clk_miso_off", "aud_clk_miso_on", "aud_dat_mosi_off", "aud_dat_mosi_on", "aud_dat_miso_off", "aud_dat_miso_on", "aud_smartpa_off", "aud_smartpa_on", "extamp-pullhigh", "extamp-pulllow";
		pinctrl-0 = <0xe3>;
		pinctrl-1 = <0xe4>;
		pinctrl-2 = <0xe5>;
		pinctrl-3 = <0xe6>;
		pinctrl-4 = <0xe7>;
		pinctrl-5 = <0xe8>;
		pinctrl-6 = <0xe9>;
		pinctrl-7 = <0xea>;
		pinctrl-8 = <0xeb>;
		pinctrl-9 = <0xec>;
		pinctrl-10 = <0xed>;
		pinctrl-11 = <0xee>;
	};

	camera_af_hw_node-sink {
		status = "okay";
		phandle = <0x48>;
		camaf_m1_pmic-supply = <0x63>;
	};

	chosen-sink {
		status = "disabled";
		phandle = <0x49>;
		atag,videolfb-fb_base_h = <0x00>;
		atag,videolfb-fb_base_l = "^`P";
		atag,videolfb-islcmfound = <0x01>;
		atag,videolfb-islcm_inited = <0x00>;
		atag,videolfb-fps = <0x1770>;
		atag,videolfb-vramSize = <0x17bb000>;
		atag,videolfb-lcmname = "nt35695B_fhd_dsi_cmd_auo_rt5081_drv";
	};

	chr_stat-sink {
		status = "okay";
		phandle = <0x4a>;
		interrupt-parent = <0x10>;
		interrupts = <0x0b 0x08 0x0b 0x00>;
	};

	consys-sink {
		status = "okay";
		phandle = <0x4b>;
		pinctrl-names = "default", "gps_lna_state_init", "gps_lna_state_oh", "gps_lna_state_ol";
		pinctrl-0 = <0xda>;
		pinctrl-1 = <0xdb>;
		pinctrl-2 = <0xdc>;
		pinctrl-3 = <0xdd>;
