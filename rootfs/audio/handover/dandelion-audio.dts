		keyboard@10010000 {
			compatible = "mediatek,mt6765-keypad", "mediatek,mt6779-keypad";
			reg = <0x00 0x10010000 0x00 0x1000>;
			interrupts = <0x00 0xb4 0x02>;
			clocks = <0x0e>;
			clock-names = "kpd";
			keypad,num-rows = <0x09>;
			keypad,num-columns = <0x08>;
			debounce-delay-ms = <0x0f>;
			linux,keymap = <0x73 0x10072>;
			status = "okay";
			phandle = <0x91>;
		};

		timer@10017000 {
			compatible = "mediatek,mt6765-timer";
			reg = <0x00 0x10017000 0x00 0x1000>;
