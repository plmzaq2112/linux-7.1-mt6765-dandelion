			reg = <0x00 0x13000000 0x00 0x80000>;
			interrupts = <0x00 0x103 0x08>;
			interrupt-names = "RGX";
			clock-frequency = <0x21f98280>;
			clocks = <0x11 0x64 0x28 0x04>;
			clock-names = "mfg", "mfgpll";
			power-domains = <0x1d 0x08 0x1d 0x04 0x1d 0x07>;
			power-domain-names = "async", "mfg", "core0";
			mediatek,mfgcfg = <0xc0>;
			status = "okay";
		};

		clock-controller@15020000 {
			compatible = "mediatek,mt6765-imgsys", "syscon";
			reg = <0x00 0x15020000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x13>;
		};

		memory-controller@15021000 {
			compatible = "mediatek,mt6765-smi-larb", "mediatek,mt8192-smi-larb";
			reg = <0x00 0x15021000 0x00 0x1000>;
			clocks = <0x12 0x18 0x13 0x00>;
			clock-names = "apb", "smi", "gals";
			power-domains = <0x1d 0x05>;
			mediatek,smi = <0x2f>;
			mediatek,larb-id = <0x02>;
			phandle = <0x1a>;
		};

		clock-controller@17000000 {
			compatible = "mediatek,mt6765-vcodecsys", "syscon";
			reg = <0x00 0x17000000 0x00 0x10000>;
			#clock-cells = <0x01>;
			phandle = <0x15>;
		};

		memory-controller@17010000 {
			compatible = "mediatek,mt6765-smi-larb", "mediatek,mt8192-smi-larb";
			reg = <0x00 0x17010000 0x00 0x1000>;
			clocks = <0x15 0x00 0x15 0x01>;
			clock-names = "apb", "smi";
			power-domains = <0x1d 0x0a>;
			mediatek,smi = <0x2f>;
			mediatek,larb-id = <0x01>;
			phandle = <0x19>;
		};

		clock-controller@1a000000 {
			compatible = "mediatek,mt6765-camsys", "syscon";
			reg = <0x00 0x1a000000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x14>;
		};

		memory-controller@1a002000 {
			compatible = "mediatek,mt6765-smi-larb", "mediatek,mt8192-smi-larb";
			reg = <0x00 0x1a002000 0x00 0x1000>;
			clocks = <0x12 0x19 0x14 0x00>;
			clock-names = "apb", "smi";
			power-domains = <0x1d 0x09>;
			mediatek,smi = <0x2f>;
			mediatek,larb-id = <0x03>;
			phandle = <0x1b>;
		};
	};

	chosen {
		bootargs = "earlycon=mtk8250,0x11002000 console=ttyS0,921600n1 console=tty0                clk_ignore_unused regulator_ignore_unused pd_ignore_unused PMOS_NOSPLASH ramoops.mem_address=0x47c90000 ramoops.mem_size=0xe0000 ramoops.pmsg_size=0x10000 ramoops.console_size=0x40000";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0:921600n8";

		framebuffer@7ec50000 {
			compatible = "simple-framebuffer";
			reg = <0x00 0x7ec50000 0x00 0xfb0000>;
			power-domains = <0x1d 0x03>;
			width = <0x2d0>;
			height = <0x640>;
			stride = <0xb80>;
			format = "a8r8g8b8";
			status = "okay";
			phandle = <0xbc>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x80000000>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			linux,cma-default;
			size = <0x00 0x2000000>;
			alloc-ranges = <0x00 0x40000000 0x00 0x40000000>;
		};
	};

	ldo-vusb33 {
		compatible = "regulator-fixed";
		regulator-name = "vusb33-reg";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-enable-ramp-delay = <0x108>;
		phandle = <0x1f>;
	};

	emi@10219000 {
		compatible = "mediatek,emi";
		reg = <0x00 0x10219000 0x00 0x1000 0x00 0x10226000 0x00 0x1000 0x00 0x1022d000 0x00 0x1000 0x00 0x10235000 0x00 0x1000>;
		interrupt-parent = <0x0f>;
		interrupts = <0x00 0x90 0x08>;
	};

	scp@10500000 {
		compatible = "mediatek,scp";
		status = "okay";
		reg = <0x00 0x10500000 0x00 0x40000 0x00 0x105c0000 0x00 0x3000 0x00 0x105c4000 0x00 0x1000 0x00 0x105d4000 0x00 0x6000>;
		interrupt-parent = <0x0f>;
		interrupts = <0x00 0xc0 0x04>;
		core_1 = "enable";
		scp_sramSize = <0x40000>;
		scp_mem_key = "mediatek,reserve-memory-scp_share";
		scp_mem_tbl = <0x01 0x100000 0x04 0x200000>;
	};

	utos {
		compatible = "microtrust,utos";
		interrupt-parent = <0x0f>;
		interrupts = <0x00 0xf9 0x01 0x00 0xfa 0x01>;
	};

