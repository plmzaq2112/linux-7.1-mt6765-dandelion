	backlight {
		compatible = "pwm-backlight";
		pwms = <0xa3 0x00 0x186a0>;
		brightness-levels = <0x00 0x04 0x08 0x10 0x20 0x40 0x60 0x80 0xa0 0xc0 0xe0 0xff>;
		default-brightness-level = <0x0a>;
		enable-gpios = <0x10 0x9a 0x00>;
	};

	battery {
		compatible = "simple-battery";
		voltage-min-design-microvolt = <0x33e140>;
		voltage-max-design-microvolt = <0x432380>;
		charge-full-design-microamp-hours = <0x4c4b40>;
		ocv-capacity-table-0 = <0x42d560 0x64 0x419ce0 0x5f 0x401640 0x58 0x3e8fa0 0x4e 0x3d0900 0x42 0x3b8260 0x36 0x39fbc0 0x2a 0x393870 0x23 0x387520 0x1c 0x37b1d0 0x14 0x36ee80 0x0c 0x362b30 0x06 0x34a490 0x02 0x33e140 0x00>;
		ocv-capacity-celsius = <0x19>;
		phandle = <0xc5>;
	};

	adc-battery {
		compatible = "adc-battery";
		io-channels = <0x76 0x00>;
		io-channel-names = "voltage";
		monitored-battery = <0xc5>;
	};

	sound {
		compatible = "mediatek,mt6765-mt6357";
		mediatek,platform = <0xc6>;
	};
};
