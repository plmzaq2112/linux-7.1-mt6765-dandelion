/dts-v1/;

/ {
	compatible = "xiaomi,dandelion", "mediatek,mt6762", "mediatek,mt6765";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	chassis-type = "handset";
	model = "Xiaomi Redmi 9A";

	accdet-sink {
		status = "disabled";
		phandle = <0x46>;
	};

	audgpio-sink {
		status = "disabled";
		phandle = <0x47>;
	};

	camera_af_hw_node-sink {
		status = "disabled";
		phandle = <0x48>;
	};

	chosen-sink {
		status = "disabled";
		phandle = <0x49>;
	};

	chr_stat-sink {
		status = "disabled";
		phandle = <0x4a>;
	};

	consys-sink {
		status = "disabled";
		phandle = <0x4b>;
	};

	dsi_te-sink {
		status = "disabled";
		phandle = <0x4c>;
	};

	flashlights_sy7803-sink {
		status = "disabled";
		phandle = <0x4d>;
	};

	fpsensor_finger-sink {
		status = "disabled";
		phandle = <0x4e>;
	};

	fpsensor_fp_eint-sink {
		status = "disabled";
		phandle = <0x4f>;
	};

	gpio-sink {
		status = "disabled";
		phandle = <0x50>;
	};

	gpio_usage_mapping-sink {
		status = "disabled";
		phandle = <0x51>;
	};

	i2c7-sink {
		status = "disabled";
		phandle = <0x52>;
	};

	i2c8-sink {
		status = "disabled";
		phandle = <0x53>;
	};

	i2c9-sink {
		status = "disabled";
		phandle = <0x54>;
	};

	irq_nfc-sink {
		status = "disabled";
		phandle = <0x55>;
	};

	irtx_pwm-sink {
		status = "disabled";
		phandle = <0x56>;
	};

	kd_camera_hw1-sink {
		status = "disabled";
		phandle = <0x57>;
	};

	main_pmic-sink {
		status = "disabled";
		phandle = <0x58>;
	};

	md1_sim1_hot_plug_eint-sink {
		status = "disabled";
		phandle = <0x59>;
	};

	md1_sim2_hot_plug_eint-sink {
		status = "disabled";
		phandle = <0x5a>;
	};

	md_auxadc-sink {
		status = "disabled";
		phandle = <0x5b>;
	};

	msdc1_ins-sink {
		status = "disabled";
		phandle = <0x5c>;
	};

	mt6370_chg-sink {
		status = "disabled";
		phandle = <0x5d>;
	};

	mt6370_pmu-sink {
		status = "disabled";
		phandle = <0x5e>;
	};

	mt6370_typec-sink {
		status = "disabled";
		phandle = <0x5f>;
	};

	mt_pmic_vcama_ldo_reg-sink {
		status = "disabled";
		phandle = <0x60>;
	};

	mt_pmic_vcamd_ldo_reg-sink {
		status = "disabled";
		phandle = <0x61>;
	};

	mt_pmic_vcamio_ldo_reg-sink {
		status = "disabled";
		phandle = <0x62>;
	};

	mt_pmic_vldo28_ldo_reg-sink {
		status = "disabled";
		phandle = <0x63>;
	};

	mt_pmic_vsim1_ldo_reg-sink {
		status = "disabled";
		phandle = <0x64>;
	};

	mt_pmic_vsim2_ldo_reg-sink {
		status = "disabled";
		phandle = <0x65>;
	};

	mtkfb-sink {
		status = "disabled";
		phandle = <0x66>;
	};

	odm-sink {
		status = "disabled";
		phandle = <0x67>;
	};

	otg_iddig-sink {
		status = "disabled";
		phandle = <0x68>;
	};

	pmic_clock_buffer_ctrl-sink {
		status = "disabled";
		phandle = <0x69>;
	};

	swtp-sink {
		status = "disabled";
		phandle = <0x6a>;
	};

	swtp1-sink {
		status = "disabled";
		phandle = <0x6b>;
	};

	thermal_message-sink {
		status = "disabled";
		phandle = <0x6c>;
	};

	touch-sink {
		status = "disabled";
		phandle = <0x6d>;
	};

	aliases {
		i2c0 = "/soc/i2c@11007000";
		i2c1 = "/soc/i2c@11008000";
		i2c2 = "/soc/i2c@11009000";
		i2c3 = "/soc/i2c@1100f000";
		i2c4 = "/soc/i2c@11011000";
		i2c5 = "/soc/i2c@11016000";
		i2c6 = "/soc/i2c@1100d000";
		spi0 = "/soc/spi@1100a000";
		spi1 = "/soc/spi@11010000";
		spi2 = "/soc/spi@11012000";
		spi3 = "/soc/spi@11013000";
		spi4 = "/soc/spi@11014000";
		spi5 = "/soc/spi@11015000";
		ovl0 = "/soc/ovl@1400b000";
		ovl-2l0 = "/soc/ovl@1400c000";
		serial0 = "/soc/serial@11002000";
		serial1 = "/soc/serial@11003000";
		mmc0 = "/soc/mmc@11230000";
		mmc1 = "/soc/mmc@11240000";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x02>;
				};

				core1 {
					cpu = <0x03>;
				};

				core2 {
					cpu = <0x04>;
				};

				core3 {
					cpu = <0x05>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x06>;
				};

				core1 {
					cpu = <0x07>;
				};

				core2 {
					cpu = <0x08>;
				};

				core3 {
					cpu = <0x09>;
				};
			};
		};

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			clock-frequency = <0x77359400>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			next-level-cache = <0x0a>;
			proc-supply = <0x0b>;
			sram-supply = <0x0c>;
			phandle = <0x02>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x01>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			clock-frequency = <0x77359400>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			next-level-cache = <0x0a>;
			proc-supply = <0x0b>;
			sram-supply = <0x0c>;
			phandle = <0x03>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x02>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			clock-frequency = <0x77359400>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			next-level-cache = <0x0a>;
			proc-supply = <0x0b>;
			sram-supply = <0x0c>;
			phandle = <0x04>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x03>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			clock-frequency = <0x77359400>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			next-level-cache = <0x0a>;
			proc-supply = <0x0b>;
			sram-supply = <0x0c>;
			phandle = <0x05>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x100>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x2e4>;
			clock-frequency = "Yh/";
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			next-level-cache = <0x0d>;
			proc-supply = <0x0b>;
			sram-supply = <0x0c>;
			phandle = <0x06>;
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x101>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x2e4>;
			clock-frequency = "Yh/";
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			next-level-cache = <0x0d>;
			proc-supply = <0x0b>;
			sram-supply = <0x0c>;
			phandle = <0x07>;
		};

		cpu@102 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x102>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x2e4>;
			clock-frequency = "Yh/";
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			next-level-cache = <0x0d>;
			proc-supply = <0x0b>;
			sram-supply = <0x0c>;
			phandle = <0x08>;
		};

		cpu@103 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x103>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x2e4>;
			clock-frequency = "Yh/";
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			next-level-cache = <0x0d>;
			proc-supply = <0x0b>;
			sram-supply = <0x0c>;
			phandle = <0x09>;
		};

		l2-cache0 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-size = <0x80000>;
			cache-line-size = <0x40>;
			cache-sets = <0x200>;
			cache-unified;
			phandle = <0x0a>;
		};

		l2-cache1 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-size = <0x80000>;
			cache-line-size = <0x40>;
			cache-sets = <0x200>;
			cache-unified;
			phandle = <0x0d>;
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	fixed-factor-clock-13m {
		compatible = "fixed-factor-clock";
		#clock-cells = <0x00>;
		clocks = <0x0e>;
		clock-div = <0x02>;
		clock-mult = <0x01>;
		clock-output-names = "clk13m";
		phandle = <0x17>;
	};

	oscillator {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x18cba80>;
		clock-output-names = "clk26m";
		phandle = <0x0e>;
	};

	oscillator1 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x8000>;
		clock-output-names = "clk32k";
		phandle = <0x2e>;
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x0f>;
		interrupts = <0x01 0x0d 0x08 0x01 0x0e 0x08 0x01 0x0b 0x08 0x01 0x0a 0x08>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupt-parent = <0x0f>;
		interrupts = <0x01 0x07 0x08>;
	};

	soc {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		efuse@08000000 {
			compatible = "mediatek,efuse";
			reg = <0x00 0x8000000 0x00 0x10>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			phandle = <0x6e>;
		};

		interrupt-controller@0c000000 {
			compatible = "arm,gic-v3";
			reg = <0x00 0xc000000 0x00 0x40000 0x00 0xc100000 0x00 0x200000 0x00 0xc400000 0x00 0x2000 0x00 0xc410000 0x00 0x2000 0x00 0xc420000 0x00 0x20000>;
			#interrupt-cells = <0x03>;
			interrupt-parent = <0x0f>;
			interrupts = <0x01 0x09 0x04>;
			interrupt-controller;
			phandle = <0x0f>;
		};

		clock-controller@10000000 {
			compatible = "mediatek,mt6765-topckgen", "syscon";
			reg = <0x00 0x10000000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x11>;
		};

		clock-controller@10001000 {
			compatible = "mediatek,mt6765-infracfg", "syscon";
			reg = <0x00 0x10001000 0x00 0x1000>;
			interrupts = <0x00 0x93 0x01>;
			#clock-cells = <0x01>;
			phandle = <0x16>;
		};

		clock-controller@10003000 {
			compatible = "mediatek,mt6765-pericfg", "syscon";
			reg = <0x00 0x10003000 0x00 0x1000>;
			phandle = <0x6f>;
		};

		pin-controller@10005000 {
			compatible = "mediatek,mt6765-pinctrl";
			reg = <0x00 0x10005000 0x00 0x1000 0x00 0x10002c00 0x00 0x200 0x00 0x10002800 0x00 0x200 0x00 0x10002a00 0x00 0x200 0x00 0x10002000 0x00 0x200 0x00 0x10002200 0x00 0x200 0x00 0x10002400 0x00 0x200 0x00 0x10002600 0x00 0x200 0x00 0x1000b000 0x00 0x1000>;
			reg-names = "iocfg0", "iocfg1", "iocfg2", "iocfg3", "iocfg4", "iocfg5", "iocfg6", "iocfg7", "eint";
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x10 0x00 0x00 0xb3>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupts = <0x00 0xab 0x04>;
			phandle = <0x10>;

			spi3-pins {
				phandle = <0xc1>;

				pins {
					pinmux = <0x1501 0x1601 0x1701 0x1801>;
				};
			};

			gpio-keys-pins {
				phandle = <0x45>;

				pins {
					pinmux = <0x5d01>;
					bias-pull-up;
					input-enable;
				};
			};

			i2c5-pins {
				phandle = <0x1e>;

				pins-bus {
					pinmux = <0x3001 0x3101>;
					bias-pull-up;
				};
			};

			i2c0-pins {
				phandle = <0xbd>;

				pins-bus {
					pinmux = <0x5301 0x5201>;
					bias-pull-up;
				};
			};

			i2c1-pins {
				phandle = <0xbe>;

				pins-bus {
					pinmux = <0x5401 0x5101>;
					bias-pull-up;
				};
			};

			i2c2-pins {
				phandle = <0xbf>;

				pins-bus {
					pinmux = <0x6701 0x6801>;
					bias-pull-up;
				};
			};

			i2c3-pins {
				phandle = <0xc2>;

				pins-bus {
					pinmux = <0x3201 0x3301>;
					bias-pull-up;
				};
			};

			i2c4-pins {
				phandle = <0xc3>;

				pins-bus {
					pinmux = <0x6901 0x6a01>;
					bias-pull-up;
				};
			};

			i2c6-pins {
				phandle = <0xc4>;

				pins-bus {
					pinmux = <0xa101 0xa201>;
					bias-pull-up;
				};
			};

			mmc0-pins-default {
				phandle = <0x24>;

				pins_cmd_dat {
					pinmux = <0x7b01 0x8001 0x7d01 0x8401 0x7e01 0x8101 0x7f01 0x8202 0x7a02>;
					input-enable;
					drive-strength = <0x03>;
					bias-pull-up = <0x65>;
				};

				pins_clk {
					pinmux = <0x7c02>;
					drive-strength = <0x03>;
					bias-pull-down = <0x66>;
				};

				pins_rst {
					pinmux = <0x8502>;
					drive-strength = <0x03>;
					bias-pull-down = <0x65>;
				};
			};

			mmc0-pins-uhs {
				phandle = <0x25>;

				pins_cmd_dat {
					pinmux = <0x7b01 0x8001 0x7d01 0x8401 0x7e01 0x8101 0x7f01 0x8202 0x7a02>;
					input-enable;
					drive-strength = <0x04>;
					bias-pull-up = <0x65>;
				};

				pins_clk {
					pinmux = <0x7c02>;
					drive-strength = <0x04>;
					bias-pull-down = <0x66>;
				};

				pins_ds {
					pinmux = <0x8302>;
					drive-strength = <0x04>;
					bias-pull-down = <0x66>;
				};

				pins_rst {
					pinmux = <0x8502>;
					drive-strength = <0x03>;
					bias-pull-down = <0x65>;
				};
			};

			mmc1-default-pins {
				phandle = <0x29>;

				pins-cmd-dat {
					pinmux = <0x2001 0x2201 0x2101 0x1f01 0x1e01>;
					input-enable;
					drive-strength = <0x03>;
					bias-pull-up = <0x65>;
				};

				pins-clk {
					pinmux = <0x1d01>;
					drive-strength = <0x03>;
					bias-pull-down = <0x66>;
				};

				pins-insert {
					pinmux = <0x100>;
					bias-pull-up;
				};
			};

			uart0-pins {
				phandle = <0x70>;

				pins {
					pinmux = <0x5f01 0x6001>;
				};
			};

			usb-pins {
				phandle = <0x22>;

				id-pins {
					pinmux = <0x2901>;
					input-enable;
					bias-pull-up;
				};

				usb-vbus-pins {
					pinmux = <0x2a01>;
					output-high;
				};
			};
		};

		clock-controller@10006000 {
			compatible = "mediatek,mt6765-scpsys", "syscon", "simple-mfd";
			reg = <0x00 0x10006000 0x00 0x1000>;
			phandle = <0x71>;

			power-controller {
				compatible = "mediatek,mt6765-power-controller";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				#power-domain-cells = <0x01>;
				phandle = <0x1d>;

				power-domain@0 {
					reg = <0x00>;
					#power-domain-cells = <0x00>;
				};

				power-domain@1 {
					reg = <0x01>;
					#power-domain-cells = <0x00>;
				};

				power-domain@2 {
					reg = <0x02>;
					#power-domain-cells = <0x00>;
				};

				power-domain@3 {
					reg = <0x03>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#power-domain-cells = <0x01>;
					clocks = <0x11 0x62 0x12 0x13 0x12 0x15 0x12 0x16 0x12 0x14>;
					clock-names = "mm", "mm-0", "mm-1", "mm-2", "mm-3";

					power-domain@5 {
						reg = <0x05>;
						#power-domain-cells = <0x00>;
						clocks = <0x13 0x00 0x12 0x18>;
						clock-names = "isp-0", "isp-1";
					};

					power-domain@9 {
						reg = <0x09>;
						#power-domain-cells = <0x00>;
						clocks = <0x14 0x00 0x14 0x01 0x14 0x02 0x14 0x08 0x12 0x19>;
						clock-names = "cam-0", "cam-1", "cam-2", "cam-3", "cam-4";
					};

					power-domain@10 {
						reg = <0x0a>;
						clocks = <0x15 0x01 0x15 0x03 0x15 0x02>;
						clock-names = "vcodec-0", "vcodec-1", "vcodec-2";
						#power-domain-cells = <0x00>;
					};
				};

				power-domain@6 {
					reg = <0x06>;
					#power-domain-cells = <0x00>;
				};

				power-domain@8 {
					reg = <0x08>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#power-domain-cells = <0x01>;
					phandle = <0x72>;

					power-domain@4 {
						reg = <0x04>;
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						#power-domain-cells = <0x01>;
						clocks = <0x11 0x64>;
						clock-names = "mfg";

						power-domain@7 {
							reg = <0x07>;
							#power-domain-cells = <0x00>;
						};
					};
				};
			};
		};

		reset-controller@10007000 {
