+			         ui32S3IrqDbg - 1U, ui32Evt, ui32MipsEn, ui32MipsSt,
+			         (IMG_UINT32)psDevInfo->bRGXPowered));
+		}
+	}
+#endif
+
 	if (RGXFwIrqEventRx(psDevInfo))
